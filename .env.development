# CallNusa mobile — public configuration only.
# NEVER put SIP passwords, API secrets, or push server keys in this file:
# they are delivered per-device by /api/v1/provisioning/device and stored in
# the OS keystore/keychain.

# Backend base URL (must be https outside local development)
# Local backend (docker compose in laravel-callnusa). Mac LAN IP so the iOS
# simulator, Android emulator and physical devices on the same Wi-Fi all reach
# it; localhost inside a simulator is the device itself.
API_BASE_URL=http://192.168.1.31:8000

# Shown on the About screen — GPL-3.0 requires the source to be reachable
SOURCE_REPOSITORY_URL=https://github.com/callnusa/callnusa-mobile

# SIP
SIP_USER_AGENT=CallNusa
SIP_REGISTER_EXPIRY_SECONDS=600
SIP_VERBOSE_LOGGING=true

# HTTP
API_TIMEOUT_MS=15000

# Local development only; ignored in production builds
ALLOW_INSECURE_TRANSPORT=true
